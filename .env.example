# See backend/.env.example for the full, documented list of environment
# variables. Set them in your hosting provider's dashboard (never commit
# real values). Quick local-dev reference:
#
#   cd backend
#   $env:DATABASE_URL = "sqlite:///./app.db"   # PowerShell, per terminal
#   $env:SECRET_KEY = "<long random string>"   # so logins survive restarts
#   python -m app.seed
#   uvicorn app.main:app --reload
#
# Generate a secret key with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
DATABASE_URL=sqlite:///./app.db
SECRET_KEY=
