# Egyptian Home Food Marketplace — environment variables.
#
# For local dev, copy to backend/.env (the app reads real environment
# variables; a .env file is just documentation — set them in your shell
# or hosting dashboard). For production, set these in your hosting
# provider's dashboard (Render/Railway/VPS), NEVER commit real values.
#
# Generate a secret key with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# --- REQUIRED in production -------------------------------------------
# Signs login tokens. MUST be a long random string. If unset (or a known
# placeholder like "changeme"), the app logs a loud warning and uses a
# random per-boot key — logins die on every restart/worker.
SECRET_KEY=

# Postgres connection string. Examples:
#   Render/Railway internal: postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME
#   Local dev (SQLite file):  sqlite:///./app.db
DATABASE_URL=postgresql+psycopg2://marketplace:marketplace@localhost:5432/marketplace

# Public URL of the site, no trailing slash. Used for Stripe redirect URLs
# and links inside emails. MUST be set to your real domain in production.
FRONTEND_URL=https://www.example.com

# --- Payments (Stripe) — get from https://dashboard.stripe.com/apikeys ----
# Without these, card payments return 501 "card payments not configured"
# (cash orders keep working).
STRIPE_SECRET_KEY=
# From the Stripe webhook endpoint settings (after you add the webhook URL).
STRIPE_WEBHOOK_SECRET=

# --- Email (Resend) — get from https://resend.com/api-keys ----------------
# Without this, emails are printed to the server console instead of sent
# (order flows keep working).
RESEND_API_KEY=
# Must be a verified sender domain in Resend, e.g. "Osiris <orders@yourdomain.com>"
EMAIL_FROM=Osiris Marketplace <noreply@example.com>

# --- Optional ------------------------------------------------------------
# Login token lifetime in minutes (default 10080 = 7 days).
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Comma-separated origins allowed to call the API cross-origin.
# Leave empty (default): same-origin only — correct when the app serves
# the frontend itself, which is the normal setup.
CORS_ORIGINS=
